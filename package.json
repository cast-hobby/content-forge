{
  "name": "content-forge",
  "version": "1.0.0",
  "description": "Editorial content pipeline for personal brands and boutique agencies. A gift from Alexander Cast · UGC Colombia × Kreoon.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Alexander Cast",
    "url": "https://ugccolombia.co"
  },
  "homepage": "https://github.com/AlexanderKast/content-forge",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderKast/content-forge.git"
  },
  "keywords": [
    "content-generation",
    "instagram",
    "carousel",
    "ai",
    "gemini",
    "nanobanana",
    "personal-brand",
    "ugc",
    "claude-code"
  ],
  "scripts": {
    "start": "node tools/overlay-editor/server.mjs",
    "editor": "node tools/overlay-editor/server.mjs",
    "setup": "node scripts/setup.mjs",
    "generate": "node scripts/generate-social.mjs",
    "compose": "node scripts/compose-overlay.mjs",
    "clone": "node scripts/clone-from-url.mjs",
    "brand-overlay": "node scripts/brand-overlay.mjs",
    "analyze-character": "node scripts/analyze-character.mjs",
    "ship": "node scripts/ship-content.mjs",
    "quality:check": "node scripts/validate-system.mjs",
    "memory:view": "node -e \"import('./scripts/load-memory.mjs').then(m=>m.loadMemory()).then(d=>console.log(JSON.stringify(d,null,2)))\"",
    "memory:reset": "node -e \"const fs=await import('node:fs/promises');await fs.copyFile('memory.json.template','memory.json');console.log('memory.json reset')\""
  },
  "dependencies": {
    "@fontsource/anton": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/montserrat": "^5.2.8",
    "@google/genai": "^1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^16.4.5",
    "openai": "^6.34.0",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2",
    "sharp": "^0.33.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
